{
  "functions": {
    "api/sonora-frio.js": { "maxDuration": 60 },
    "api/resumen-frio.js": { "maxDuration": 60 },
    "api/resumen-frio/*.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/resumen-pronostico", "destination": "/api/resumen-frio?tipo=pronostico" },
    { "source": "/api/resumen-pronostico/:slug*", "destination": "/api/resumen-frio?tipo=pronostico" }
  ]
}
